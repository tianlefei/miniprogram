.page { min-height: 100vh; background: #f2f4f8; }
.content { padding: 24rpx; }
.card { margin-bottom: 24rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; }
.card-title { display: block; margin-bottom: 24rpx; font-size: 32rpx; font-weight: 600; }
.input { box-sizing: border-box; width: 100%; padding: 22rpx; margin-bottom: 20rpx; background: #f5f7fb; border-radius: 12rpx; }
.btn { text-align: center; padding: 22rpx; border-radius: 12rpx; }
.btn-primary { color: #fff; background: #2b6de5; }
.remark { display: block; margin-top: 12rpx; color: #697386; }
.invite { display: flex; justify-content: space-between; align-items: center; }.copy { color: #2b6de5; }.member { display: flex; justify-content: space-between; padding-top: 18rpx; color: #596579; }.member-id { max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; }
