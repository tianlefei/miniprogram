/* pages/index/index.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f2f4f8;
}

/* ---------- 顶部渐变 ---------- */
.hero {
  flex: none;
  background: linear-gradient(135deg, #1d5fe0 0%, #3f8cff 60%, #56a6ff 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  padding-bottom: 28rpx;
}

.hero-body {
  padding: 12rpx 28rpx 0;
}

.stats {
  display: flex;
  justify-content: space-between;
}

.stat {
  width: 31.8%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  padding: 22rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 46rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.05;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.tip {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
}

.tip-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffe0e0;
  color: #e5484d;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #33384a;
}

.tip-arrow {
  color: #b3bacb;
  font-size: 34rpx;
  margin-left: 8rpx;
}

/* ---------- 搜索 & 筛选 ---------- */
.toolbar {
  flex: none;
  padding: 24rpx 28rpx 8rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #ffffff;
  border-radius: 38rpx;
  padding: 0 26rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.7;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1f2e;
}

.search-clear {
  width: 40rpx;
  text-align: center;
  color: #b3bacb;
  font-size: 36rpx;
}

.filters {
  display: flex;
  margin-top: 22rpx;
}

.filter {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #ffffff;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #6b7488;
}

.filter-active {
  background: #2b6de5;
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 列表 ---------- */
.list {
  padding: 20rpx 28rpx 0;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(29, 62, 128, 0.06);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-title-box {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1f2e;
  max-width: 380rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tag {
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #2b6de5;
  font-size: 20rpx;
}

.badge {
  flex: none;
  margin-left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.rows {
  margin-top: 22rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9rpx 0;
}

.row-k {
  font-size: 26rpx;
  color: #8a94a6;
}

.row-v {
  font-size: 26rpx;
  color: #33384a;
  max-width: 400rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.progress {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #eef1f6;
  overflow: hidden;
}

.progress-bar {
  height: 12rpx;
  border-radius: 6rpx;
}

.progress-text {
  margin-left: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex: none;
}

.list-bottom {
  height: 180rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #33384a;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8a94a6;
}

.empty-actions {
  margin-top: 48rpx;
  display: flex;
}

.empty-btn {
  padding: 20rpx 44rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #2b6de5 0%, #4f8dff 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-btn-plain {
  background: #ffffff;
  color: #2b6de5;
  margin-left: 24rpx;
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 44rpx;
  bottom: 56rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: linear-gradient(135deg, #2b6de5 0%, #4f8dff 100%);
  box-shadow: 0 12rpx 28rpx rgba(43, 109, 229, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-hover {
  transform: scale(0.94);
}

.fab-plus {
  color: #ffffff;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -6rpx;
}

/* ---------- 账号 / 云同步 ---------- */
.account {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.account .tip-arrow {
  color: rgba(255, 255, 255, 0.7);
  margin-left: 6rpx;
}

.sync {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.sync-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: rgba(255, 255, 255, 0.6);
}

.sync-on {
  background: #7dffb0;
}

.sync-ing {
  background: #ffd166;
}

.sync-off {
  background: rgba(255, 255, 255, 0.6);
}

.sync-err {
  background: #ff8b8b;
}

.sync-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sync-action {
  flex: none;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.22);
}
