/* pages/add/add.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f2f4f8;
}

.form {
  padding: 28rpx 28rpx 0;
}

.group {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 8rpx 28rpx 4rpx;
  margin-bottom: 24rpx;
}

.group-title {
  display: block;
  font-size: 24rpx;
  color: #8a94a6;
  font-weight: 600;
  padding: 24rpx 0 10rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 2rpx solid #f2f4f8;
}

.field-last {
  border-bottom: none;
}

.field-column {
  display: block;
  padding: 26rpx 0;
}

.field-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #33384a;
  flex: none;
}

.req {
  color: #e5484d;
  margin-left: 4rpx;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1a1f2e;
  margin-left: 24rpx;
}

.input-short {
  flex: none;
  width: 160rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  background: #f5f7fb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-value .value {
  font-size: 28rpx;
  color: #1a1f2e;
}

.picker-value .placeholder {
  font-size: 28rpx;
  color: #b3bacb;
}

.arrow {
  margin-left: 12rpx;
  color: #c3cad8;
  font-size: 34rpx;
}

.presets {
  display: flex;
  margin-top: 22rpx;
}

.preset {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  background: #f2f6ff;
  color: #2b6de5;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1a1f2e;
  line-height: 1.6;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: #9aa3b5;
  line-height: 1.6;
  padding: 16rpx 0 24rpx;
  border-top: 2rpx solid #f2f4f8;
}

.form-bottom {
  height: 200rpx;
}

/* 底部保存栏 */
.footer {
  flex: none;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(29, 62, 128, 0.06);
}

.footer .btn {
  width: 100%;
  box-sizing: border-box;
}
