.page{min-height:100vh;background:#f2f4f8}.content{padding:28rpx}.profile-card,.menu{display:flex;align-items:center;padding:30rpx;background:#fff;border-radius:20rpx}.avatar{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;margin-right:24rpx;color:#fff;font-size:38rpx;font-weight:600;background:#2b6de5;border-radius:50%}.profile-info{flex:1}.name,.menu-title{display:block;color:#1a1f2e;font-size:32rpx;font-weight:600}.desc,.menu-desc{display:block;margin-top:10rpx;color:#8a94a6;font-size:26rpx}.arrow{margin-left:auto;color:#a6adbb;font-size:42rpx}.section{margin-top:28rpx}.section-title{display:block;margin:0 8rpx 16rpx;color:#697386;font-size:26rpx}.menu>view{flex:1}
