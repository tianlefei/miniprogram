<view class="page"><navigation-bar title="个人中心" back="{{false}}" color="#1a1f2e" background="#ffffff"></navigation-bar><view class="content"><view class="profile-card" bindtap="editProfile"><view class="avatar">{{name.slice(0, 1)}}</view><view class="profile-info"><text class="name">{{name}}</text><text class="desc">查看和修改个人资料</text></view><text class="arrow">›</text></view><view class="section"><text class="section-title">团队</text><view class="menu" bindtap="manageTeam"><view><text class="menu-title">{{teamName}}</text><text class="menu-desc">{{memberCount > 0 ? memberCount + ' 位成员' : '创建团队或使用邀请码加入'}}</text></view><text class="arrow">›</text></view></view></view></view>
