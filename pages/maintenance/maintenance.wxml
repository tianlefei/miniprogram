<view class="page"><navigation-bar title="新增维护记录" back="{{true}}" color="#1a1f2e" background="#ffffff"></navigation-bar><view class="form"><view class="group"><text class="group-title">记录类型</text><picker range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange"><view class="field"><text class="label">类型</text><text>{{types[typeIndex]}}</text></view></picker></view><view class="group"><text class="group-title">处理信息</text><text class="hint">维护人自动使用当前个人资料姓名</text><textarea class="textarea" placeholder="填写检查、保养、维修或更换内容" data-key="content" bindinput="onInput"></textarea></view><view class="btn" bindtap="submit">保存记录</view></view></view>
